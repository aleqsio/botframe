{
	"name": "aleqsiodesign",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "lefthook install",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"knip": "knip",
		"jscpd": "jscpd src",
		"check": "bun run format:check && bun run lint && bun run typecheck && bun run knip && bun run jscpd && bun run test"
	},
	"devDependencies": {
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-react-you-might-not-need-an-effect": "1.0.2",
		"jscpd": "5.2.0",
		"knip": "6.35.0",
		"lefthook": "2.1.12",
		"oxfmt": "0.67.0",
		"oxlint": "1.82.0",
		"oxlint-plugin-complexity": "2.1.8",
		"oxlint-tsgolint": "7.0.2001",
		"typescript": "7.0.2",
		"vitest": "5.0.0"
	},
	"engines": {
		"bun": ">=1.3",
		"node": ">=26"
	},
	"packageManager": "bun@1.3.14",
	"trustedDependencies": [
		"lefthook"
	]
}
