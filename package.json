{
	"name": "botframe",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "out/main/index.js",
	"scripts": {
		"prepare": "lefthook install",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"knip": "knip",
		"jscpd": "jscpd src",
		"check": "bun run format:check && bun run lint && bun run typecheck && bun run knip && bun run jscpd && bun run test",
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"start": "electron-vite preview",
		"dev:web": "vite",
		"build:web": "vite build",
		"start:web": "vite build && vite preview",
		"test:e2e": "electron-vite build && playwright test --project electron",
		"test:e2e:chromium": "vite build && playwright test --project chromium"
	},
	"dependencies": {
		"@base-ui-components/react": "1.0.0-rc.0",
		"loro-crdt": "1.16.0",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@rolldown/plugin-babel": "0.2.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"babel-plugin-react-compiler": "1.0.0",
		"electron": "44.3.0",
		"electron-vite": "6.0.0-beta.1",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-react-you-might-not-need-an-effect": "1.0.2",
		"jscpd": "5.2.0",
		"knip": "6.35.0",
		"lefthook": "2.1.12",
		"oxfmt": "0.67.0",
		"oxlint": "1.82.0",
		"oxlint-plugin-complexity": "2.1.8",
		"oxlint-tsgolint": "7.0.2001",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vitest": "5.0.0"
	},
	"engines": {
		"bun": ">=1.3",
		"node": ">=26"
	},
	"packageManager": "bun@1.3.14",
	"trustedDependencies": [
		"electron",
		"esbuild",
		"lefthook"
	]
}
